{
  "name": "hkgeocode-geolibre-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "GeoLibre plugin that draws the Hong Kong geocode grid for the current map view.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build:geolibre": "vite build --config vite.geolibre.config.ts",
    "package:geolibre": "npm run build:geolibre && node scripts/package-geolibre-plugin.mjs",
    "serve:geolibre": "node scripts/serve-geolibre-plugin.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "proj4": "^2.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "maplibre-gl": "^5.6.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
